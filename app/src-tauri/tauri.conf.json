{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workbench",
  "identifier": "dev.maxjay.workbench",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0e0f0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Max Jay",
    "copyright": "Copyright 2026 Max Jay. All rights reserved."
  }
}
